                Tahoma,
                Geneva,
                Verdana,
                sans-serif;

            color: #453b55;

            line-height: 1.7;

            background:
                linear-gradient(
                    rgba(169, 143, 232, 0.05) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(169, 143, 232, 0.05) 1px,
                    transparent 1px
                ),
                #fbf9ff;

            background-size:
                26px 26px;

        }


        .container {

            width: 90%;

            max-width: 1100px;

            margin: auto;

        }


        /* =====================================
           NAVIGATION
        ====================================== */

        nav {

            position: sticky;

            top: 15px;

            z-index: 100;

            width: 90%;

            max-width: 1100px;

            margin: 15px auto;

            padding: 15px 20px;

            display: flex;

            justify-content: space-between;

            align-items: center;

            background:
                rgba(255, 255, 255, 0.9);

            backdrop-filter: blur(12px);

            border:
                1px solid #e6ddf5;

            border-radius: 20px;

            box-shadow:
                0 10px 30px
                rgba(100, 80, 140, 0.08);

        }


        .logo {

            font-size: 20px;

            font-weight: bold;

            color: #765eb7;

        }


        .logo span {

            color: #e28bae;

        }


        nav ul {

            display: flex;

            gap: 10px;

            list-style: none;

        }


        nav a {

            text-decoration: none;

            color: #766c82;

            padding: 8px 12px;

            border-radius: 12px;

            font-weight: 600;

            transition: 0.2s;

        }


        nav a:hover {

            background: #eee8ff;

            color: #765eb7;

        }


        /* =====================================
           HOME
        ====================================== */

        .hero {

            min-height: 720px;

            display: grid;

            grid-template-columns:
                1.1fr 0.9fr;

            align-items: center;

            gap: 70px;

            padding: 70px 0;

        }


        .hello {

            display: inline-block;

            background: #fff0f6;

            color: #b36188;

            padding: 7px 14px;

            border-radius: 50px;

            font-size: 14px;

            font-weight: bold;

            margin-bottom: 20px;

        }


        .hero h1 {

            font-size:
                clamp(
                    55px,
                    8vw,
                    95px
                );

            line-height: 0.95;

            color: #534568;

            margin-bottom: 20px;

        }


        .hero h1 span {

            color: #a98fe8;

        }


        .full-name {

            font-size: 19px;

            color: #746683;

            font-weight: 600;

            margin-bottom: 8px;

        }


        .nickname {

            display: inline-block;

            padding: 5px 12px;

            background: #fff0f6;

            color: #b05f87;

            border-radius: 30px;

            font-size: 14px;

            font-weight: bold;

            margin-bottom: 15px;

        }


        .job {

            font-size: 24px;

            font-weight: bold;

            color: #765eb7;

            margin-bottom: 15px;

        }


        .hero-description {

            color: #777080;

            margin-bottom: 28px;

            font-size: 17px;

        }


        /* =====================================
           BUTTON
        ====================================== */

        .buttons {

            display: flex;

            flex-wrap: wrap;

            gap: 12px;

        }


        .btn {

            display: inline-block;

            padding: 12px 20px;

            text-decoration: none;

            border-radius: 14px;

            font-weight: bold;

            transition: 0.25s;

        }


        .btn:hover {

            transform: translateY(-3px);

        }


        .btn-primary {

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #a68be5,
                    #755dc1
                );

            box-shadow:
                0 10px 25px
                rgba(117, 93, 193, 0.25);

        }


        .btn-white {

            background: white;

            border:
                1px solid #ddd3f2;

            color: #765eb7;

        }


        /* =====================================
           PROFILE PHOTO
        ====================================== */

        .photo-area {

            display: flex;

            justify-content: center;

        }


        .photo-card {

            width: 400px;

            max-width: 100%;

            padding:
                16px
                16px
                25px;

            background: white;

            border-radius: 30px;

            transform: rotate(2deg);

            border:
                1px solid #e9e1f4;

            box-shadow:
                0 20px 60px
                rgba(90, 70, 130, 0.15);

            position: relative;

        }


        /* เทปตกแต่งรูป */

        .photo-card::before {

            content: "";

            position: absolute;

            width: 100px;

            height: 28px;

            top: -14px;

            left: 50%;

            transform:
                translateX(-50%)
                rotate(-3deg);

            background:
                rgba(
                    255,
                    228,
                    164,
                    0.75
                );

            border-radius: 5px;

        }


        .photo {

            width: 100%;

            aspect-ratio: 4 / 5;

            border-radius: 22px;

            overflow: hidden;

            background: #f5f1ff;

        }


        /* ใช้รูปต้นฉบับ ไม่ใส่ Filter */

        .photo img {

            width: 100%;

            height: 100%;

            object-fit: contain;

            display: block;

        }


        .photo-name {

            text-align: center;

            margin-top: 15px;

            color: #765eb7;

            font-weight: bold;

        }


        .photo-fullname {

            text-align: center;

            color: #92889c;

            font-size: 13px;

            margin-top: 3px;

        }


