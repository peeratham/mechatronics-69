           SECTIONS
        ====================================== */

        section {

            padding: 90px 0;

        }


        .section-head {

            text-align: center;

            margin-bottom: 40px;

        }


        .mini-title {

            display: inline-block;

            background: #fff0f6;

            color: #b36188;

            padding: 6px 13px;

            border-radius: 50px;

            font-size: 13px;

