                grid-template-columns: 1fr;

            }


            .hero h1 {

                font-size: 55px;

            }


            .contact h2 {

                font-size: 35px;

            }


            section {

                padding: 65px 0;

            }


            .photo-card {

                transform: none;

            }

        }

    </style>

